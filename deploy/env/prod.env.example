# ─────────────────────────────────────────────────────────────────────────
# Прод-окружение TNOISE (tnoise.com). Скопируйте в .env рядом с проектом
# и заполните значения (особенно все CHANGE_ME).
#
#   cp deploy/env/prod.env.example .env
#   $EDITOR .env
#
# Секреты генерировать так:
#   DJANGO_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
#   POSTGRES_PASSWORD: openssl rand -base64 24
# ─────────────────────────────────────────────────────────────────────────

# test | preprod | prod — в prod DEBUG принудительно False, SECRET_KEY обязателен.
ENVIRONMENT=prod

# ── PostgreSQL ──
# Docker:   POSTGRES_HOST=db   (имя сервиса из docker-compose.prod.yml)
# Нативно:  POSTGRES_HOST=127.0.0.1
POSTGRES_DB=med_ear_prod
POSTGRES_USER=med_ear_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Django ──
DJANGO_SECRET_KEY=CHANGE_ME_random_min_50_chars
DJANGO_ALLOWED_HOSTS=tnoise.com,www.tnoise.com
# CSRF/CORS: в prod дефолт CSRF уже https://tnoise.com,https://www.tnoise.com
CORS_ALLOWED_ORIGINS=https://tnoise.com,https://www.tnoise.com
AUTH_RATE_LIMIT=5/m

# Публичная документация на /docs/ (в образе она есть). Пусто → маршрута нет.
DOCS_DIR=/app/docs

# ── Let's Encrypt (используется init-letsencrypt.sh) ──
CERTBOT_DOMAINS=tnoise.com www.tnoise.com
CERTBOT_EMAIL=admin@tnoise.com

# ── Бэкапы (deploy/scripts/backup.sh) ──
# Куда класть локальные бэкапы и сколько дней хранить.
BACKUP_DIR=/var/backups/tnoise
BACKUP_KEEP_DAYS=14

# Опциональная выгрузка в S3-совместимое хранилище.
# S3_ENABLED=true включает upload после локального бэкапа.
# Требует установленного aws-cli (pip install awscli / пакет awscli).
S3_ENABLED=false
S3_BUCKET=
S3_PREFIX=tnoise/backups
# Для не-AWS (Yandex/Minio/Selectel и т.п.) укажите endpoint, иначе оставьте пустым.
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
